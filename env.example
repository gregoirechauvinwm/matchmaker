# .env.example — template of required environment variables.
# Copy to .env for local development and fill in real values. NEVER commit .env.
# In Railway, set these in the service's Variables tab (per environment).
#
# Each environment (local / staging / production) must have its OWN database and
# its OWN secrets. Never share a database between staging and production.

# --- core ---
# Postgres connection string (Neon). Use a SEPARATE database per environment.
DATABASE_URL=

# 'development' | 'production'. Controls dev-only behavior such as the SMS
# verification bypass. MUST be 'production' in the production environment.
NODE_ENV=

# Port the server listens on. Railway injects this automatically — do not hardcode
# it in production. Locally, 3000 is fine.
PORT=3000

# Back-office admin password.
ADMIN_PASSWORD=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Cloudflare R2 (media storage) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Stripe ---
# Use TEST keys (sk_test_… / pk_test_…) in local + staging, LIVE keys in prod.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# REQUIRED IN PRODUCTION: the webhook signing secret (whsec_…). Without it the
# webhook cannot verify Stripe's signature. Get it from the Stripe dashboard for
# the webhook endpoint pointing at https://YOUR_DOMAIN/webhook.
STRIPE_WEBHOOK_SECRET=

# --- SMS verification (Twilio Verify) ---
# REQUIRED IN PRODUCTION. When NODE_ENV is not 'production', the app uses the dev
# bypass code instead of sending real SMS, so these can be left blank locally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
